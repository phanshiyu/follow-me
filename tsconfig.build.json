{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["bin", "src"],
  "exclude": ["src/**/*.test.ts"]
}
